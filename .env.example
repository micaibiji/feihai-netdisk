APP_NAME=飞海网盘
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成至少16位的强密码
DATA_DIR=/app/data
STRM_DIR=/app/strm

# 飞牛NAS宿主机目录：请在Compose部署前改成你的实际共享文件夹
FEIHAI_DATA_PATH=./data
FNTV_STRM_PATH=./strm

# 资源搜索与追更：PanSou同时聚合Telegram频道和网盘搜索插件
PANSOU_BASE_URL=http://pansou:8888
PANSOU_CHANNELS=tgsearchers3,Lsp115,oneonefivewpfx,ypquark,yunpan139
SUBSCRIPTION_INTERVAL_SECONDS=1800
PROVIDER_PRIORITY=115,baidu,quark,china_mobile

PUBLIC_BASE_URL=http://你的NAS地址:12366

# 可选：TMDB，用于影视信息识别
TMDB_API_KEY=

# 百度官方 OAuth（可选；填写后显示百度官方一键授权）
BAIDU_CLIENT_ID=
BAIDU_REDIRECT_URI=

# 可选：Telegram 通知
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 可选：企业微信机器人通知
WECOM_WEBHOOK_URL=

# 兼容旧版：也可继续通过环境变量传入。网页保存时会使用本机密钥加密。
CHINA_MOBILE_TOKEN=
QUARK_COOKIE=
BAIDU_ACCESS_TOKEN=
115_ACCESS_TOKEN=
