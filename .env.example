APP_NAME=飞海网盘
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成至少16位的强密码
DATA_DIR=/app/data
STRM_DIR=/app/strm

# 飞牛NAS宿主机目录：请在Compose部署前改成你的实际共享文件夹
FEIHAI_DATA_PATH=./data
FNTV_STRM_PATH=./strm

# 飞牛“文件管理 → 远程挂载”的宿主机挂载目录。
# 只把已经在飞牛中登录并挂载的网盘名称写入 NATIVE_MOUNT_PROVIDERS。
NATIVE_MOUNT_PROVIDERS=
FNOS_115_PATH=./netdisk/115
FNOS_BAIDU_PATH=./netdisk/baidu
FNOS_QUARK_PATH=./netdisk/quark
FNOS_MOBILE_PATH=./netdisk/china_mobile

# 资源搜索与链接检测在飞海网盘的“设置”页面连接你已有的服务。
# 飞海网盘不安装 PanSou 或检测站，也不会为它们占用新的 NAS 端口。
SUBSCRIPTION_INTERVAL_SECONDS=1800
PROVIDER_PRIORITY=115,baidu,quark,china_mobile

PUBLIC_BASE_URL=http://你的NAS地址:12366

# 可选：TMDB，用于影视信息识别
TMDB_API_KEY=

# 百度官方 OAuth（可选；填写后显示百度官方一键授权）
BAIDU_CLIENT_ID=
BAIDU_REDIRECT_URI=

# 可选：Telegram 通知
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 可选：企业微信机器人通知
WECOM_WEBHOOK_URL=

# 兼容旧版：也可继续通过环境变量传入。网页保存时会使用本机密钥加密。
CHINA_MOBILE_TOKEN=
QUARK_COOKIE=
BAIDU_ACCESS_TOKEN=
115_ACCESS_TOKEN=
